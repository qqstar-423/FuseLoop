{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stage9 decision and executable task plan, version 2",
  "description": "Author one task list. The program derives writable/inspect lists and the history action_plan; never submit those derived fields.",
  "type": "object",
  "properties": {
    "plan_version": {
      "type": "integer",
      "const": 2
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "const": 4
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "const": "0f505cd0c7c74b8781c319af2b697690"
    },
    "ledger_entry": {
      "type": "object",
      "properties": {
        "evaluation_summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "direction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "readonly_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S",
            "description": "Concrete file relative to the work directory; no absolute paths, parent traversal, directories (even for inspect) or globs."
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "case_analysis": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S",
                "enum": [
                  "level3/fused_patch_concat_layernorm_19",
                  "level3/fused_patch_concat_layernorm_10",
                  "level3/fused_patch_concat_layernorm_1",
                  "level3/fused_patch_concat_layernorm_12",
                  "level3/fused_patch_concat_layernorm_3",
                  "level3/fused_patch_concat_layernorm_11"
                ]
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "next_action": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "case_id",
              "observation",
              "explanation",
              "evidence",
              "next_action"
            ],
            "additionalProperties": false
          },
          "minItems": 6,
          "maxItems": 6,
          "description": "One analysis per listed performance case; do not repeat case_id."
        }
      },
      "required": [
        "evaluation_summary",
        "direction",
        "readonly_files",
        "case_analysis"
      ],
      "additionalProperties": false
    },
    "suggest_next": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "priority": {
            "enum": [
              "P0",
              "P1",
              "P2"
            ]
          },
          "task_type": {
            "enum": [
              "inspect",
              "modify"
            ]
          },
          "action": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "case_scope": {
            "enum": [
              "cases",
              "operator"
            ]
          },
          "target_cases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "operator_reason": {
            "type": "string"
          },
          "case_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "case_id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "implementation_files": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "\\S",
                    "description": "Concrete file relative to the work directory; no absolute paths, parent traversal, directories (even for inspect) or globs."
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "route_evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "file": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S",
                        "description": "Concrete file relative to the work directory; no absolute paths, parent traversal, directories (even for inspect) or globs."
                      },
                      "location": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      },
                      "explanation": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    },
                    "required": [
                      "file",
                      "location",
                      "explanation"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "required": [
                "case_id",
                "implementation_files",
                "route_evidence"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "description": "Concrete file relative to the work directory; no absolute paths, parent traversal, directories (even for inspect) or globs."
                },
                "operation": {
                  "enum": [
                    "inspect",
                    "modify",
                    "create"
                  ]
                },
                "location": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                },
                "method": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "required": [
                "file",
                "operation",
                "location",
                "method"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "acceptance_checks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "minItems": 1
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "human_message_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "required": [
          "task_id",
          "priority",
          "task_type",
          "action",
          "reason",
          "case_scope",
          "target_cases",
          "operator_reason",
          "case_bindings",
          "changes",
          "acceptance_checks"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "insights": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "bottleneck_now": {
      "type": "string"
    },
    "worst_cases_tracker": {
      "type": "object"
    },
    "fusion_kernel_strategy": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        }
      ]
    },
    "proven_pattern": {
      "type": "object",
      "properties": {
        "what_changed": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "why_it_worked": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "fusion_related": {
          "type": "boolean"
        },
        "applicability": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "next_action": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "object",
              "minProperties": 1
            },
            {
              "type": "array",
              "minItems": 1
            }
          ]
        },
        "case_analysis": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "observation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "case_id",
              "observation",
              "explanation"
            ]
          }
        }
      },
      "required": [
        "what_changed",
        "why_it_worked",
        "fusion_related",
        "applicability",
        "next_action",
        "evidence",
        "case_analysis"
      ]
    },
    "human_responses": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "minItems": 0
    }
  },
  "required": [
    "plan_version",
    "iteration",
    "request_id",
    "ledger_entry",
    "suggest_next",
    "proven_pattern"
  ],
  "additionalProperties": false
}